   "source": [
    "# ============================================================\n",
    "#  FULL GRAVITATIONAL LENSING PIPELINE\n",
    "#  HST Einstein Ring Reconstruction\n",
    "#\n",
    "#  Features:\n",
    "#  ----------\n",
    "#   Real FITS image handling\n",
    "#   Lens galaxy masking\n",
    "#   Arc-only likelihood weighting\n",
    "#   SIE + external shear lens model\n",
    "#   Two-source reconstruction\n",
    "#   PSF convolution\n",
    "#   Bayesian inference\n",
    "#   MCMC parameter estimation\n",
    "#   Publication-style diagnostics\n",
    "\n",
    "# ============================================================\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from astropy.io import fits\n",
    "from scipy.ndimage import gaussian_filter\n",
    "from scipy.optimize import differential_evolution\n",
    "\n",
    "from astropy.convolution import convolve_fft\n",
    "from astropy.convolution import Gaussian2DKernel\n",
    "\n",
    "import emcee\n",
    "import corner\n",
    "\n",
    "# ============================================================\n",
    "# LOAD IMAGE\n",
    "# ============================================================\n",
    "\n",
    "image = fits.getdata(\"image.fits\")\n",
    "\n",
    "if image.ndim > 2:\n",
    "    image = image[0]\n",
    "\n",
    "image = image.astype(float)\n",
    "\n",
    "# Normalize\n",
    "image -= np.min(image)\n",
    "image /= np.max(image)\n",
    "\n",
    "observed = image.copy()\n",
    "\n",
    "ny, nx = observed.shape\n",
    "\n",
    "# ============================================================\n",
    "# COORDINATES\n",
    "# ============================================================\n",
    "\n",
    "y, x = np.indices(observed.shape)\n",
    "\n",
    "# Fixed lens center\n",
    "cx, cy = 223, 311\n",
    "\n",
    "X = x - cx\n",
    "Y = y - cy\n",
    "\n",
    "R = np.sqrt(X**2 + Y**2)\n",
    "\n",
    "# ============================================================\n",
    "# CENTRAL GALAXY MASK\n",
    "# ============================================================\n",
    "\n",
    "galaxy_mask = R < 55\n",
    "\n",
    "observed_fit = observed.copy()\n",
    "observed_fit[galaxy_mask] = 0\n",
    "\n",
    "# ============================================================\n",
    "# ARC MASK\n",
    "# ============================================================\n",
    "\n",
    "smooth = gaussian_filter(observed_fit, 2)\n",
    "\n",
    "gx, gy = np.gradient(smooth)\n",
    "\n",
    "grad = np.sqrt(gx**2 + gy**2)\n",
    "\n",
    "arc_mask = (\n",
    "    (grad > np.percentile(grad, 92)) &\n",
    "    (R > 80) &\n",
    "    (R < 170)\n",
    ")\n",
    "\n",
    "arc_mask = gaussian_filter(\n",
    "    arc_mask.astype(float),\n",
    "    2\n",
    ")\n",
    "\n",
    "arc_mask = arc_mask > 0.2\n",
    "\n",
    "# ============================================================\n",
    "# ARC WEIGHTS\n",
    "# ============================================================\n",
    "\n",
    "weights = np.ones_like(observed)\n",
    "\n",
    "weights[arc_mask] = 15.0\n",
    "\n",
    "# ============================================================\n",
    "# PSF\n",
    "# ============================================================\n",
    "\n",
    "psf_kernel = Gaussian2DKernel(1.2)\n",
    "\n",
    "# ============================================================\n",
    "# SERSIC SOURCE\n",
    "# ============================================================\n",
    "\n",
    "def sersic_source(\n",
    "    x,\n",
    "    y,\n",
    "    x0,\n",
    "    y0,\n",
    "    Re,\n",
    "    n,\n",
    "    amp,\n",
    "    q,\n",
    "    phi\n",
    "):\n",
    "\n",
    "    xp = (\n",
    "        (x - x0)*np.cos(phi) +\n",
    "        (y - y0)*np.sin(phi)\n",
    "    )\n",
    "\n",
    "    yp = (\n",
    "        -(x - x0)*np.sin(phi) +\n",
    "        (y - y0)*np.cos(phi)\n",
    "    )\n",
    "\n",
    "    r = np.sqrt(\n",
    "        xp**2 + (yp/q)**2\n",
    "    )\n",
    "\n",
    "    bn = 2*n - 0.324\n",
    "\n",
    "    return amp * np.exp(\n",
    "        -bn * ((r/Re)**(1/n) - 1)\n",
    "    )\n",
    "\n",
    "# ============================================================\n",
    "# SIE DEFLECTION\n",
    "# ============================================================\n",
    "\n",
    "def sie_deflection(\n",
    "    x,\n",
    "    y,\n",
    "    theta_E,\n",
    "    q,\n",
    "    phi\n",
    "):\n",
    "\n",
    "    xp = (\n",
    "        x*np.cos(phi) +\n",
    "        y*np.sin(phi)\n",
    "    )\n",
    "\n",
    "    yp = (\n",
    "        -x*np.sin(phi) +\n",
    "        y*np.cos(phi)\n",
    "    )\n",
    "\n",
    "    eps = np.sqrt(1 - q**2)\n",
    "\n",
    "    psi = np.sqrt(\n",
    "        q**2 * (xp**2) + yp**2 + 1e-8\n",
    "    )\n",
    "\n",
    "    ax = (\n",
    "        theta_E / eps *\n",
    "        np.arctan(\n",
    "            eps*xp/(psi + 1e-8)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    ay = (\n",
    "        theta_E / eps *\n",
    "        np.arctanh(\n",
    "            eps*yp/(psi + q**2 + 1e-8)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    alpha_x = (\n",
    "        ax*np.cos(phi) -\n",
    "        ay*np.sin(phi)\n",
    "    )\n",
    "\n",
    "    alpha_y = (\n",
    "        ax*np.sin(phi) +\n",
    "        ay*np.cos(phi)\n",
    "    )\n",
    "\n",
    "    return alpha_x, alpha_y\n",
    "\n",
    "# ============================================================\n",
    "# EXTERNAL SHEAR\n",
    "# ============================================================\n",
    "\n",
    "def shear_deflection(\n",
    "    x,\n",
    "    y,\n",
    "    gamma,\n",
    "    phi_gamma\n",
    "):\n",
    "\n",
    "    gx = gamma * (\n",
    "        x*np.cos(2*phi_gamma) +\n",
    "        y*np.sin(2*phi_gamma)\n",
    "    )\n",
    "\n",
    "    gy = gamma * (\n",
    "        y*np.cos(2*phi_gamma) -\n",
    "        x*np.sin(2*phi_gamma)\n",
    "    )\n",
    "\n",
    "    return gx, gy\n",
    "\n",
    "# ============================================================\n",
    "# FULL MODEL\n",
    "# ============================================================\n",
    "\n",
    "def make_model(params):\n",
    "\n",
    "    (\n",
    "        theta_E,\n",
    "        q,\n",
    "        phi,\n",
    "\n",
    "        sx1,\n",
    "        sy1,\n",
    "        Re1,\n",
    "\n",
    "        sx2,\n",
    "        sy2,\n",
    "\n",
    "        gamma\n",
    "    ) = params\n",
    "\n",
    "    # -------------------------\n",
    "    # Deflections\n",
    "    # -------------------------\n",
    "\n",
    "    ax1, ay1 = sie_deflection(\n",
    "        X,\n",
    "        Y,\n",
    "        theta_E,\n",
    "        q,\n",
    "        phi\n",
    "    )\n",
    "\n",
    "    ax2, ay2 = shear_deflection(\n",
    "        X,\n",
    "        Y,\n",
    "        gamma,\n",
    "        np.deg2rad(-20)\n",
    "    )\n",
    "\n",
    "    alpha_x = ax1 + ax2\n",
    "    alpha_y = ay1 + ay2\n",
    "\n",
    "    # -------------------------\n",
    "    # Source plane coordinates\n",
    "    # -------------------------\n",
    "\n",
    "    beta_x = X - alpha_x\n",
    "    beta_y = Y - alpha_y\n",
    "\n",
    "    # -------------------------\n",
    "    # SOURCE 1\n",
    "    # -------------------------\n",
    "\n",
    "    src1 = sersic_source(\n",
    "        beta_x,\n",
    "        beta_y,\n",
    "\n",
    "        sx1,\n",
    "        sy1,\n",
    "\n",
    "        Re=3.2,\n",
    "        n=1.0,\n",
    "        amp=15,\n",
    "\n",
    "        q=0.45,\n",
    "        phi=np.deg2rad(15)\n",
    "    )\n",
    "\n",
    "    # -------------------------\n",
    "    # SOURCE 2\n",
    "    # -------------------------\n",
    "\n",
    "    src2 = sersic_source(\n",
    "        beta_x,\n",
    "        beta_y,\n",
    "\n",
    "        sx2,\n",
    "        sy2,\n",
    "\n",
    "        Re=1.2,\n",
    "        n=0.8,\n",
    "        amp=4,\n",
    "\n",
    "        q=0.8,\n",
    "        phi=np.deg2rad(-20)\n",
    "    )\n",
    "\n",
    "    model = src1 + src2\n",
    "\n",
    "    # -------------------------\n",
    "    # PSF convolution\n",
    "    # -------------------------\n",
    "\n",
    "    model = convolve_fft(\n",
    "        model,\n",
    "        psf_kernel,\n",
    "        normalize_kernel=True\n",
    "    )\n",
    "\n",
    "    # -------------------------\n",
    "    # light smoothing\n",
    "    # -------------------------\n",
    "\n",
    "    model = gaussian_filter(\n",
    "        model,\n",
    "        0.35\n",
    "    )\n",
    "\n",
    "    # Normalize\n",
    "    model /= np.max(model)\n",
    "\n",
    "    return model\n",
    "\n",
    "# ============================================================\n",
    "# LIKELIHOOD\n",
    "# ============================================================\n",
    "\n",
    "sigma2 = 0.01**2\n",
    "\n",
    "def log_likelihood(params):\n",
    "\n",
    "    model = make_model(params)\n",
    "\n",
    "    obs_log = np.log10(\n",
    "        observed_fit + 1e-6\n",
    "    )\n",
    "\n",
    "    mod_log = np.log10(\n",
    "        model + 1e-6\n",
    "    )\n",
    "\n",
    "    chi2 = np.sum(\n",
    "        weights *\n",
    "        ((obs_log - mod_log)**2)\n",
    "    )\n",
    "\n",
    "    return -0.5 * chi2\n",
    "\n",
    "# ============================================================\n",
    "# PRIORS\n",
    "# ============================================================\n",
    "\n",
    "def log_prior(params):\n",
    "\n",
    "    (\n",
    "        theta_E,\n",
    "        q,\n",
    "        phi,\n",
    "\n",
    "        sx1,\n",
    "        sy1,\n",
    "        Re1,\n",
    "\n",
    "        sx2,\n",
    "        sy2,\n",
    "\n",
    "        gamma\n",
    "    ) = params\n",
    "\n",
    "    if not (70 < theta_E < 150):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (0.3 < q < 1.0):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (-np.pi < phi < np.pi):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (-40 < sx1 < 40):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (-40 < sy1 < 40):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (0.5 < Re1 < 10):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (-40 < sx2 < 40):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (-40 < sy2 < 40):\n",
    "        return -np.inf\n",
    "\n",
    "    if not (0 < gamma < 0.2):\n",
    "        return -np.inf\n",
    "\n",
    "    return 0.0\n",
    "\n",
    "# ============================================================\n",
    "# POSTERIOR\n",
    "# ============================================================\n",
    "\n",
    "def log_probability(params):\n",
    "\n",
    "    lp = log_prior(params)\n",
    "\n",
    "    if not np.isfinite(lp):\n",
    "        return -np.inf\n",
    "\n",
    "    return lp + log_likelihood(params)\n",
    "\n",
    "# ============================================================\n",
    "# INITIAL PARAMETERS\n",
    "# ============================================================\n",
    "\n",
    "initial = np.array([\n",
    "\n",
    "    118,                # theta_E\n",
    "    0.63,               # q\n",
    "    np.deg2rad(28),     # phi\n",
    "\n",
    "    8.0,                # sx1\n",
    "    -6.0,               # sy1\n",
    "    3.0,                # Re1\n",
    "\n",
    "    -5.0,               # sx2\n",
    "    4.0,                # sy2\n",
    "\n",
    "    0.06                # gamma\n",
    "])\n",
    "\n",
    "# ============================================================\n",
    "# OPTIMIZATION\n",
    "# ============================================================\n",
    "\n",
    "bounds = [\n",
    "\n",
    "    (70, 150),\n",
    "    (0.3, 1.0),\n",
    "    (-np.pi, np.pi),\n",
    "\n",
    "    (-40, 40),\n",
    "    (-40, 40),\n",
    "    (0.5, 10),\n",
    "\n",
    "    (-40, 40),\n",
    "    (-40, 40),\n",
    "\n",
    "    (0.0, 0.2)\n",
    "]\n",
    "\n",
    "def neg_loglike(p):\n",
    "    return -log_likelihood(p)\n",
    "\n",
    "result = differential_evolution(\n",
    "    neg_loglike,\n",
    "    bounds,\n",
    "    maxiter=100\n",
    ")\n",
    "\n",
    "best = result.x\n",
    "\n",
    "print(\"\\nBEST FIT PARAMETERS:\\n\")\n",
    "print(best)\n",
    "\n",
    "# ============================================================\n",
    "# MCMC\n",
    "# ============================================================\n",
    "\n",
    "ndim = len(best)\n",
    "nwalkers = 20\n",
    "pos = best + 1e-3 * np.random.randn(\n",
    "    nwalkers,\n",
    "    ndim\n",
    ")\n",
    "\n",
    "sampler = emcee.EnsembleSampler(\n",
    "    nwalkers,\n",
    "    ndim,\n",
    "    log_probability\n",
    ")\n",
    "\n",
    "print(\"\\nRunning MCMC...\\n\")\n",
    "\n",
    "nsteps = 500\n",
    "\n",
    "sampler.run_mcmc(\n",
    "    pos,\n",
    "    nsteps,\n",
    "    progress=True\n",
    ")\n",
    "\n",
    "samples = sampler.get_chain(\n",
    "    discard=100,\n",
    "    thin=3,\n",
    "    flat=True\n",
    ")\n",
    "\n",
    "print(\"Samples shape:\", samples.shape)\n",
    "\n",
    "best_mcmc = np.median(\n",
    "    samples,\n",
    "    axis=0\n",
    ")\n",
    "\n",
    "print(\"\\nMCMC BEST PARAMETERS:\\n\")\n",
    "print(best_mcmc)\n",
    "\n",
    "# ============================================================\n",
    "# FINAL MODEL\n",
    "# ============================================================\n",
    "\n",
    "model = make_model(best_mcmc)\n",
    "\n",
    "residual = observed_fit - model\n",
    "\n",
    "# ============================================================\n",
    "# PLOTS\n",
    "# ============================================================\n",
    "\n",
    "fig, ax = plt.subplots(\n",
    "    2,\n",
    "    3,\n",
    "    figsize=(16,10),\n",
    "    constrained_layout=True\n",
    ")\n",
    "\n",
    "# Observed\n",
    "ax[0,0].imshow(observed_fit, cmap='inferno')\n",
    "ax[0,0].set_title(\"Observed\")\n",
    "\n",
    "# Model\n",
    "ax[0,1].imshow(model, cmap='inferno')\n",
    "ax[0,1].set_title(\"Model\")\n",
    "\n",
    "# Residual\n",
    "im = ax[0,2].imshow(\n",
    "    residual,\n",
    "    cmap='coolwarm',\n",
    "    vmin=-0.2,\n",
    "    vmax=0.2\n",
    ")\n",
    "ax[0,2].set_title(\"Residual\")\n",
    "\n",
    "# Log observed\n",
    "ax[1,0].imshow(\n",
    "    np.log10(observed_fit + 1e-6),\n",
    "    cmap='viridis'\n",
    ")\n",
    "ax[1,0].set_title(\"Observed (log)\")\n",
    "\n",
    "# Log model\n",
    "ax[1,1].imshow(\n",
    "    np.log10(model + 1e-6),\n",
    "    cmap='viridis'\n",
    ")\n",
    "ax[1,1].set_title(\"Model (log)\")\n",
    "\n",
    "# Log residual\n",
    "im2 = ax[1,2].imshow(\n",
    "    residual,\n",
    "    cmap='coolwarm',\n",
    "    vmin=-0.2,\n",
    "    vmax=0.2\n",
    ")\n",
    "\n",
    "ax[1,2].set_title(\"Residual\")\n",
    "\n",
    "# Shared colorbar\n",
    "cbar = fig.colorbar(\n",
    "    im2,\n",
    "    ax=ax,\n",
    "    fraction=0.025,\n",
    "    pad=0.02\n",
    ")\n",
    "\n",
    "# Save figure\n",
    "plt.savefig(\n",
    "    \"reconstruction.png\",\n",
    "    dpi=300,\n",
    "    bbox_inches='tight'\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "# ============================================================\n",
    "# CORNER PLOT\n",
    "# ============================================================\n",
    "labels = [\n",
    "    r\"$\\theta_E$\",\n",
    "    r\"$q$\",\n",
    "    r\"$\\phi$\",\n",
    "    r\"$sx1$\",\n",
    "    r\"$sy1$\",\n",
    "    r\"$Re1$\",\n",
    "    r\"$sx2$\",\n",
    "    r\"$sy2$\",\n",
    "    r\"$\\gamma$\"\n",
    "]\n",
    "fig = corner.corner(\n",
    "    samples,\n",
    "    labels=labels,\n",
    "    show_titles=True\n",
    ")\n",
    "\n",
    "plt.savefig(\n",
    "    \"corner_plot.png\",\n",
    "    dpi=300,\n",
    "    bbox_inches='tight'\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "np.savez(\n",
    "    \"best_fit_results.npz\",\n",
    "    best_fit=best_mcmc,\n",
    "    samples=samples\n",
    ")\n",
    "\n"
    "\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# CORNER PLOT\n",
    "# ============================================================"
   ]
  }
